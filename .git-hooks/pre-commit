#!/bin/sh

# Redirect output to stderr.
exec 1>&2

echo "Running Laravel Pint pre-commit hook..."

# Get list of staged PHP files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -z "$STAGED_FILES" ]; then
    echo "No PHP files staged for commit."
    exit 0
fi

# Run Pint on staged files
echo "Running Pint on staged PHP files..."
echo "$STAGED_FILES" | xargs ./vendor/bin/pint

# Add files back to staging
echo "$STAGED_FILES" | xargs git add

echo "Laravel Pint pre-commit hook completed successfully."
exit 0
